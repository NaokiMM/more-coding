{
    "security.workspace.trust.untrustedFiles": "open",
    "workbench.colorTheme": "Default Dark+",
    "[sql]": {
      "editor.defaultFormatter": "adpyke.vscode-sql-formatter"
    },
    "window.zoomLevel": 2,
    "liveServer.settings.donotShowInfoMsg": true,
    "explorer.confirmDelete": false,
    "workbench.startupEditor": "none",
    "explorer.confirmDragAndDrop": false,
    "[php]": {
      "editor.defaultFormatter": "kokororin.vscode-phpfmt"
    },
    "prettier.bracketSameLine": true,
    "githubPullRequests.pullBranch": "never",
    "php.validate.executablePath": "",
    "remote.autoForwardPortsSource": "hybrid",
    "diffEditor.ignoreTrimWhitespace": true,
    "docker.extension.enableComposeLanguageServer": false,
    "workbench.colorCustomizations": {
      // ネスト縦線 括弧そのものの色
      "editorBracketHighlight.foreground1": "#FFFFFF", // 白
      "editorBracketHighlight.foreground2": "#ADD8E6", // 水色
      "editorBracketHighlight.foreground3": "#87CEEB", // 空色
      "editorBracketHighlight.foreground4": "#1E90FF", // 濃い青
      "editorBracketHighlight.foreground5": "#4682B4", // 鋼青
      "editorBracketHighlight.foreground6": "#B0C4DE", // ライトスチールブルー
      // ネスト縦線 括弧ガイドの縦線（非アクティブ時）
      "editorBracketPairGuide.background1": "#ADD8E622", // 水色・薄め
      "editorBracketPairGuide.background2": "#1E90FF22", // 青・薄め
      "editorBracketPairGuide.background3": "#FFFFFF22", // 白・薄め
      // ネスト縦線 括弧ガイドの縦線（カーソルがある場所＝アクティブ時）
      "editorBracketPairGuide.activeBackground1": "#1E90FF", // 青（強調）
      "editorBracketPairGuide.activeBackground2": "#87CEFA", // 水色（強調）
      "editorBracketPairGuide.activeBackground3": "#FFFFFF", // 白（強調）
      // 「Sticky Scroll（スティッキースクロール）」機能
     "editorStickyScroll.background": "#000000",               // スティッキースクロール背景：ほぼ白（不透明度80%）
     "editorStickyScrollHeader.background": "#1E90FF",         // ヘッダー背景：もっと白め（不透明度約93%）
     "editorStickyScroll.foreground": "#1a1a1a",                 // 通常文字：黒に近い
     "editorStickyScrollHeader.foreground": "#000000",           // ヘッダー文字：完全な黒
     "editorStickyScroll.border": "#1E90FF",                     // 境界線：青系アクセント
     "editorStickyScrollHeader.border": "#1E90FF",
      // 現在の行をフォーカス
      "editor.lineHighlightBorder": "#1E90FF",
      "editor.lineHighlightBackground": "#FFFFFF22",
    },
    // Blockman
     "blockman.n03MaxDepth": 6,
     "blockman.n04ColorComboPreset": "none",
     "blockman.n06CustomColorOfDepth1": "#0b0c0e",
     "blockman.n07CustomColorOfDepth2": "#111317",
     "blockman.n08CustomColorOfDepth3": "#151920",
     "blockman.n09CustomColorOfDepth4": "#1a1f28",
     "blockman.n10CustomColorOfDepth5": "#1f2630",
     "blockman.n11CustomColorOfDepth6": "#24303c",
     "blockman.n19CustomColorOfBlockBorder": "#2f8ec1",
     "blockman.n21BorderRadius": 3,
     "blockman.n17CustomColorOfFocusedBlock": "#161c24",
    "blockman.n18CustomColorOfFocusedBlockBorder": "#3a6f9c",
    // vscode-icons
    "workbench.iconTheme": "vscode-icons",
    "vsicons.dontShowNewVersionMessage": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "editor.wordWrap": "on",
  }
  
  